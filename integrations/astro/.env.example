# Origin of the CMS — typically https://<tenant>.cms.example.com
CMS_BASE_URL=https://acme.cms.example.com

# Bearer token minted under Settings → API tokens. Mint with the minimum
# scopes you need; the token can be revoked from the CMS without
# rotating any other secret.
CMS_API_TOKEN=mbc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret for inbound webhooks. Mint a webhook in the CMS, copy
# the value of "Signing secret" here. The handler in webhook-handler.ts
# verifies HMAC-SHA256(body, secret) === request.headers["x-cms-signature"].
CMS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxx
