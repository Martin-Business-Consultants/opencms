<% @page_title = "Pending changes" %>
<%= parent_page "Approvals", approvals_path %>

<%= render "layouts/shared/page_header", title: @page_title,
      description: "Content changes from API clients and agents that can’t publish. Each is held here as a diff until someone who can publish applies or rejects it." %>

<section class="flex flex-column gap-half margin-block-end">
  <h2 class="txt-medium font-weight-bold margin-none">Waiting (<%= @pending.size %>)</h2>
  <% if @pending.any? %>
    <section class="panel shadow center index-table">
      <table class="data-table">
        <thead>
          <tr><th>Record</th><th>Fields</th><th>Proposed by</th><th>When</th><th></th></tr>
        </thead>
        <tbody>
          <% @pending.each do |revision| %>
            <%# herb:key revision.id %>
            <tr id="<%= dom_id(revision) %>" data-filter-target="item">
              <td>
                <%= link_to revision.label, revision_path(revision), class: "txt-ink font-weight-bold" %>
                <div class="txt-x-small txt-subtle"><%= revision.revisable_type %></div>
              </td>
              <td class="font-mono txt-x-small"><%= revision.changed_keys.join(", ") %></td>
              <td class="txt-subtle"><%= revision.proposed_by %> <span class="txt-x-small">via <%= revision.source %></span></td>
              <td class="txt-subtle txt-small"><%= time_ago_tag revision.created_at %></td>
              <td>
                <% if revision.stale? %>
                  <%= status_tag "Stale" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% else %>
    <p class="txt-small txt-subtle margin-none">Nothing waiting.</p>
  <% end %>
</section>

<% if @resolved.any? %>
  <section class="flex flex-column gap-half">
    <h2 class="txt-medium font-weight-bold margin-none">Recently decided</h2>
    <section class="panel shadow center index-table">
      <table class="data-table">
        <thead>
          <tr><th>Record</th><th>Outcome</th><th>By</th><th>Comment</th><th>When</th></tr>
        </thead>
        <tbody>
          <% @resolved.each do |revision| %>
            <%# herb:key revision.id %>
            <tr id="<%= dom_id(revision) %>" data-filter-target="item">
              <td><%= link_to revision.label, revision_path(revision), class: "txt-ink" %></td>
              <td><%= status_tag revision.state.humanize, highlight: revision.state == "applied" %></td>
              <td class="txt-subtle"><%= revision.decided_by&.email %></td>
              <td class="txt-subtle txt-small"><%= revision.decision_comment %></td>
              <td class="txt-subtle txt-small"><%= time_ago_tag revision.decided_at %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  </section>
<% end %>
