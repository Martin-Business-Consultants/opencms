<% @page_title = "Media Library" %>
<% can_write = Current.user.can?("assets:write") %>
<% can_delete = Current.user.can?("assets:delete") %>
<% upload_folder = @folder || "/" %>

<% if can_write %>
  <% content_for :page_actions do %>
    <%= render "file_manager/uploads", folder: upload_folder %>
  <% end %>
<% end %>
<% drop_data = can_write ? { controller: "file-drop", action: "dragenter->file-drop#enter dragover->file-drop#over dragleave->file-drop#leave drop->file-drop#drop" } : {} %>
<%= tag.div class: "file-drop", data: drop_data do %>
<%= render "layouts/shared/page_header", title: "Media Library" %>

<% if can_write %>
  <div class="file-drop__overlay" data-file-drop-target="overlay" hidden>
    <p class="file-drop__overlay-text">Drop files to upload them into <strong><%= upload_folder == "/" ? "the top level" : upload_folder %></strong>, or onto a folder.</p>
  </div>
  <p class="notice txt-small" data-file-drop-target="message" hidden></p>
  <%# The drop zone, always there, as WordPress's uploader is; a drop
      anywhere on the page works too. Focused when "+ New › Media" led here. %>
  <section class="file-drop__ready media-dropzone txt-align-start" aria-label="Upload files" data-drop-folder="<%= upload_folder %>">
    <%= icon_tag "picture-add", class: "media-dropzone__icon" %>
    <p class="margin-none">
      <strong>Drop files to upload</strong>
      <span class="txt-small txt-subtle">into <%= upload_folder == "/" ? "the top level" : upload_folder %>. A zip of images, dropped on its own, is unpacked.</span>
    </p>
    <%= tag.button "Select files", type: "button", class: "btn btn--link", autofocus: params[:upload].present?, data: { action: "file-drop#choose" } %>
  </section>
<% end %>

<%# The library, as WordPress lays it out: one toolbar (the view, the filters,
    Bulk select, search), then every file as a square, or a list. Picking one
    opens its details in a sheet (file_manager/assets#show, into the
    asset_details frame). Bulk select turns the squares into ticks. %>
<div class="media-library" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <div class="media-toolbar panel shadow">
    <%= render "layouts/shared/view_toggle", current: @view %>

    <%= form_with url: file_manager_path, method: :get, class: "media-toolbar__filters", data: { controller: "form", turbo_action: "replace" } do %>
      <%= hidden_field_tag :view, @view, id: nil %>
      <%= hidden_field_tag :q, @query, id: nil if @query.present? %>
      <%= select_tag :kind, options_for_select([ [ "All media items", "" ] ] + Asset::Filterable::KINDS.map { |key, label| [ label, key ] }, @kind),
            class: "input input--select txt-small", id: nil, aria: { label: "Kind of file" }, data: { action: "change->form#submit" } %>
      <%= select_tag :month, options_for_select([ [ "All dates", "" ] ] + @months.map { [ Date.strptime(it, "%Y-%m").strftime("%B %Y"), it ] }, @month),
            class: "input input--select txt-small", id: nil, aria: { label: "Month added" }, data: { action: "change->form#submit" } %>
      <%= select_tag :folder, options_for_select([ [ "All folders", "" ], [ "Top level", "/" ] ] + @folders.map { [ it, it ] }, @folder),
            class: "input input--select txt-small", id: nil, aria: { label: "Folder" }, data: { action: "change->form#submit" } %>
    <% end %>

    <% if @view == "cards" && @assets.any? && (can_write || can_delete) %>
      <label class="btn txt-small media-toolbar__bulk">
        <input type="checkbox" class="for-screen-reader" data-media-bulk>
        <span class="media-toolbar__bulk-on">Bulk select</span>
        <span class="media-toolbar__bulk-off">Cancel</span>
      </label>
    <% end %>

    <%= form_with url: file_manager_path, method: :get, class: "media-toolbar__search", data: { turbo_action: "replace" } do |form| %>
      <%= form.hidden_field :view, value: @view, id: nil %>
      <%= form.hidden_field :kind, value: @kind, id: nil if @kind %>
      <%= form.hidden_field :month, value: @month, id: nil if @month %>
      <%= form.hidden_field :folder, value: @folder, id: nil if @folder %>
      <label for="media_search" class="txt-small">Search</label>
      <%= form.search_field :q, value: @query, id: "media_search", class: "input txt-small", autocomplete: "off" %>
    <% end %>
  </div>

  <% if can_write && @query.blank? %>
    <%= render "file_manager/folder_actions", folder: @folder || "/", can_delete: can_delete %>
  <% end %>

  <% if @subfolders.any? %>
    <ul class="file-manager__folders margin-none">
      <% @subfolders.each do |folder| %>
        <%# herb:key folder %>
        <li data-filter-target="item">
          <%= link_to file_manager_path(folder: folder, view: @view), class: "file-manager__folder", data: { drop_folder: folder } do %>
            <%= icon_tag "folder" %>
            <span class="overflow-ellipsis"><%= AssetFolders.name(folder) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if @assets.any? %>
    <% if can_write || can_delete %>
      <%= render "file_manager/bulk_actions", folders: @folders, can_write: can_write, can_delete: can_delete %>
    <% end %>

    <% if @view == "cards" %>
      <div class="media-grid">
        <%= with_automatic_pagination :assets_cards, @page do %>
          <% @assets.each do |asset| %>
            <%# herb:key asset.id %>
            <%= render "file_manager/asset_tile", asset: asset, selectable: can_write || can_delete %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <section class="panel shadow index-table" data-controller="select-all">
        <table class="data-table" data-controller="pagination" data-pagination-paginate-on-intersection-value="true" data-pagination-discard-frame-value="true">
          <thead>
            <tr>
              <th class="data-table__check"><input type="checkbox" aria-label="Select every row" data-select-all-target="all" data-action="select-all#toggle"></th>
              <th>File</th>
              <th>Type</th>
              <th>Folder</th>
              <th class="data-table__number">Size</th>
              <th>Added</th>
            </tr>
          </thead>
          <tbody id="<%= pagination_frame_id_for(:assets_rows, @page.number) %>">
            <% @assets.each do |asset| %>
              <%# herb:key asset.id %>
              <%= render "file_manager/asset_row", asset: asset, selectable: can_write || can_delete, can_delete: can_delete %>
            <% end %>
            <%= table_next_page_row :assets_rows, @page, columns: 6 %>
          </tbody>
        </table>
      </section>
    <% end %>
    <p class="media-library__count txt-small txt-subtle"><%= pluralize(@total, "media item") %></p>
  <% elsif @query.present? || @kind || @month %>
    <div class="blank-slate">No media items found.</div>
  <% elsif @subfolders.none? %>
    <div class="blank-slate">
      No media items yet.<% if can_write %> Upload files, or drop them anywhere here; a zip of images is unpacked.<% end %>
    </div>
  <% end %>

  <dialog class="dialog dialog--sheet dialog--sheet-half panel fill-white shadow flex-column gap txt-align-start media-details"
          data-dialog-target="dialog" aria-label="Attachment details" closedby="any">
    <header class="flex align-center justify-space-between gap">
      <h2 class="txt-large font-weight-bold margin-none">Attachment details</h2>
      <button type="button" class="btn txt-small" data-action="dialog#close">Close</button>
    </header>
    <turbo-frame id="asset_details">
      <p class="txt-small txt-subtle">Loading…</p>
    </turbo-frame>
  </dialog>
</div>
<% end %>
