<%# locals: (folder:) %>
<%# Uploading into the folder being looked at. Files go straight to storage
    (Active Storage direct uploads) and the form submits their signed ids;
    the direct-upload controller shows each file's progress. %>
<%= form_with url: file_manager_assets_path, class: "file-manager__upload", data: { controller: "form direct-upload" } do |form| %>
  <%= form.hidden_field :folder, value: folder, id: nil, data: { file_drop_target: "filesFolder" } %>
  <label class="btn btn--labelled" title="Upload files">
    <%= icon_tag "add" %>
    <span>Upload files</span>
    <%= form.file_field :files, multiple: true, direct_upload: true, hidden: true,
          data: { action: "change->form#submit", direct_upload_target: "input", file_drop_target: "filesInput" } %>
  </label>
  <ul class="file-manager__progress margin-none" data-direct-upload-target="list" hidden></ul>
<% end %>

<details class="file-manager__zip" data-file-drop-target="zipBox">
  <summary class="btn btn--labelled" title="Upload a zip of images">
    <%= icon_tag "package" %>
    <span>Upload a zip</span>
  </summary>
  <%= form_with url: file_manager_bulk_uploads_path, class: "popup panel fill-white shadow flex flex-column gap-half txt-align-start", data: { controller: "direct-upload" } do |form| %>
    <%= form.hidden_field :folder, value: folder, id: nil, data: { file_drop_target: "zipFolder" } %>
    <p class="txt-small margin-none">A .zip of images, each turned into a WebP in <strong><%= folder %></strong>. HEIC, AVIF, JPEG, PNG, GIF and TIFF all work.</p>
    <%= form.file_field :archive, accept: ".zip,application/zip", direct_upload: true, required: true, class: "input full-width",
          data: { direct_upload_target: "input", file_drop_target: "zipInput" } %>
    <ul class="file-manager__progress margin-none" data-direct-upload-target="list" hidden></ul>
    <button type="submit" class="btn btn--link">
      <span>Unpack into this folder</span>
      <%= icon_tag "arrow-right" %>
    </button>
  <% end %>
</details>
