<% @page_title = "Fields: " + @page.title %>
<%= parent_page "Pages", pages_path %>

<% content_for :page_actions do %>
  <%= link_to "Edit the page", edit_page_path(@page.path), class: "btn txt-small" %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title,
      description: "The fields this page carries besides its blocks, filled in on the page’s form." %>

<%= render "layouts/shared/errors", record: @page %>
<%= form_with url: page_schema_path(@page.path), method: :patch, class: "flex flex-column gap" do %>
  <%= render "schemas/editor", fields: @page.fields, scope: "page", field_types: Page::SCHEMA_FIELD_TYPES,
        collection_slugs: Collection.order(:slug).pluck(:slug) %>
  <div>
    <button type="submit" class="btn btn--link">Save fields</button>
  </div>
<% end %>
