<%# locals: () %>
<button type="button" class="btn btn--plain theme-toggle" data-controller="theme" data-action="theme#toggle" title="Switch between light and dark">
  <%= icon_tag "moon", class: "theme-toggle__moon" %>
  <%= icon_tag "sun", class: "theme-toggle__sun" %>
  <span class="for-screen-reader">Switch between light and dark</span>
</button>
