<%# locals: (title:, param:, options:, current:) %>
<%# A Fizzy quick filter: a pill showing the current choice, opening a menu of the others.
    Each choice is a link that swaps one query param, so filters are bookmarkable. %>
<div class="quick-filter quick-filter--with-default" data-filter-show="true" data-controller="dialog" data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
  <button type="button" class="btn input input--select flex-inline txt-x-small" data-action="click->dialog#toggle:stop">
    <span class="overflow-ellipsis"><%= options.to_h.invert.fetch(current, options.first.first) %></span>
  </button>

  <dialog class="margin-block-start-half popup panel flex-column align-start gap-half fill-white shadow txt-small" aria-label="<%= title %>" data-dialog-target="dialog">
    <strong class="popup__title pad-inline-half"><%= title %></strong>
    <ul class="popup__list" role="listbox">
      <% options.each do |text, value| %>
        <%# herb:key value %>
        <li class="popup__item" role="checkbox" aria-checked="<%= value == current %>">
          <%= link_to url_for(request.query_parameters.merge(param.to_s => value)), class: "btn popup__btn", data: { turbo_action: "replace" } do %>
            <span class="overflow-ellipsis flex-item-grow"><%= text %></span>
            <%= icon_tag "check", class: "checked flex-item-justify-end" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </dialog>
</div>
