<%# locals: (frame_id:, masked:, visible:, reveal_path:, plaintext: nil) %>
<%# A token's secret: masked until Reveal is clicked (which audits the look),
    then the plaintext with a copy button, swapped into this frame. %>
<turbo-frame id="<%= frame_id %>">
  <div class="flex align-center gap-half">
    <% if plaintext %>
      <code class="settings-code flex-item-grow"><%= plaintext %></code>
      <%= copy_button plaintext %>
    <% else %>
      <code class="settings-code flex-item-grow"><%= masked %></code>
      <% if visible %>
        <%= button_to "Reveal", reveal_path, class: "btn txt-small" %>
      <% else %>
        <span class="txt-x-small txt-subtle">Issued before secrets could be shown — rotate it to get one you can copy.</span>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
