<%# locals: (redirect:, can_delete:) %>
<tr id="<%= dom_id(redirect) %>" data-filter-target="item">
  <% if can_delete %>
    <td class="data-table__check">
      <input type="checkbox" data-select-all-target="box" data-action="select-all#sync" name="ids[]" value="<%= redirect.id %>" form="redirects_bulk_deletion" aria-label="Select <%= redirect.source_path %>">
    </td>
  <% end %>
  <td>
    <%= link_to redirect.source_path, edit_tools_redirect_path(redirect), class: "txt-ink font-weight-bold font-mono",
          data: { turbo_frame: "redirect_sheet", action: "dialog#open" } %>
    <%= render "layouts/shared/row_links", name: redirect.source_path,
        delete_path: (tools_redirect_path(redirect) if can_delete),
        delete_message: "Anyone visiting " + redirect.source_path + " will get a 404 instead." %>
  </td>
  <td class="txt-subtle font-mono"><%= redirect.destination_url %></td>
  <td class="font-mono" title="<%= Redirect::STATUS_LABELS[redirect.status_code] %>"><%= redirect.status_code %></td>
  <td><%= status_tag redirect.active ? "Active" : "Disabled" %></td>
  <td class="data-table__number"><%= redirect.hit_count %></td>
</tr>
