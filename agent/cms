command("recommend", group: "Agent work",
  summary: "File a finding for a human to decide on",
  usage: "cms recommend <kind> <title> [--body T] [--impact N] [--subject page:/pricing]",
  flags: [{flag: "--body TEXT", description: "the detail"},
           {flag: "--impact N", description: "how much it matters, as a number"},
           {flag: "--subject REF", description: "page:<path> or <collection>:<slug>"}],
  notes: "The right move when you find something outside the run's remit: file it rather " \
         "than widening the run. Picks up CMS_AGENT_RUN_ID from the environment to attach " \
         "the finding to the run that produced it.") do |args|
  need!(args, 2, "cms recommend <kind> <title> [--body T] [--impact N] [--subject page:<path>]")
  kind = args.shift
  title = args.shift
  body = impact = subject = nil
  until args.empty?
    case (arg = args.shift)
    when "--body"    then body = args.shift
    when "--impact"  then impact = args.shift
    when "--subject" then subject = args.shift
    else die "unexpected argument: #{arg}"
    end
  end

  payload = {kind: kind, title: title}
  payload[:body] = body if body
  payload[:impact] = impact.to_i if impact

  if subject
    kind_part, ref_part = subject.split(":", 2)
    die "--subject looks like page:/pricing or posts:my-entry" if ref_part.nil?
    payload[:subject] = if kind_part == "page"
      {type: "Page", path: ref_part}
    else
      {type: "CollectionEntry", collection: kind_part, slug: ref_part}
    end
  end

  payload[:agent_run_id] = ENV["CMS_AGENT_RUN_ID"].to_i if ENV["CMS_AGENT_RUN_ID"].presence

  call(:post, "/recommendations", {recommendation: payload})
end

