#!/usr/bin/env ruby
# frozen_string_literal: true

# cms — a CLI over the LibrePublish CMS API, for agents (Claude Code, Codex,
# opencode, …) and for people, working on a site from a local machine.
#
# Everything the admin UI can do to content, structure and site operations is
# reachable here. The curated commands are shortcuts; `cms get|post|patch|delete
# <path>` reaches anything they don't cover, against the same API.
#
# Every call is authenticated as the user (or service token) behind the
# credential, and authorized against that role — a 403 means "your role can't do
# that", not "the API can't".
#
# Three things make this usable by an agent rather than merely callable:
#
#   --agent / --json   ask the server for the {status, summary, data,
#                      breadcrumbs} envelope, so every answer says what it is
#                      and what to do next.
#   cms commands --json    the whole surface, with flags and gotchas, in one
#                      call — no usage screen to parse.
#   cms doctor         whether this machine can actually do useful work, which
#                      is otherwise the hardest question to ask.
#
# Ruby stdlib only.

require "net/http"
require "uri"
require "json"
require "socket"
require "fileutils"
require "stringio"
require "openssl"

VERSION = "2.0.0"

# String#presence without ActiveSupport — used while resolving credentials below,
# so it has to be defined before that runs.
class String
  def presence = empty? ? nil : self
end

class NilClass
  def presence = nil
end

# --- profiles ---------------------------------------------------------------
#
# A PROFILE is one identity: a URL and a token. Usually that is you on one site,
# and the profile is named after it. They come apart the moment a machine holds
# more than one — you and a service token, or two sites — so a profile is what
# picks between them:
#
#   --profile acme      explicit, wins over everything
#   CMS_PROFILE         for a shell or a service that always means one identity
#   CMS_URL / USER_AGENT_TOKEN   set directly in the environment (CI, one-offs)
#   the default         named in ~/.config/cms/default, else the only one there
#
# The single-file config the shell CLI wrote (~/.config/cms/config) is still
# read, as the profile named "default" — an existing install keeps working.
CONFIG_DIR = File.join(ENV["XDG_CONFIG_HOME"] || File.join(Dir.home, ".config"), "cms")
LEGACY_CONFIG = ENV["CMS_CONFIG"] || File.join(CONFIG_DIR, "config")

def die(message)
  warn "cms: #{message}"
  exit 1
end

def profiles
  named = Dir.glob(File.join(CONFIG_DIR, "*.env")).map { |f| File.basename(f, ".env") }
  named << "default" if named.empty? && File.readable?(LEGACY_CONFIG)
  named.sort
end

def default_profile
  named = begin
    File.read(File.join(CONFIG_DIR, "default")).strip
  rescue StandardError
    nil
  end
  return named if named && !named.empty? && profiles.include?(named)

  profiles.first if profiles.size == 1
end

# Both files are shell-sourceable `export KEY="value"` lines, so one reader does
# for the legacy single config and the per-profile ones.
def read_env_file(path)
  return {} unless File.readable?(path)

  File.readlines(path, chomp: true).each_with_object({}) do |line, env|
    match = line.match(/\A(?:export\s+)?([A-Z_]+)="?(.*?)"?\z/) or next
    env[match[1]] = match[2]
  end
end

# A named profile that doesn't exist yet is not an error here. `cms login
# --profile acme` is how it comes to exist, and dying while resolving it would
# make the only command that can fix the problem impossible to run. The
# complaint belongs at the point of use, in require_credentials!.
def load_profile(name)
  file = File.join(CONFIG_DIR, "#{name}.env")
  return read_env_file(file) if File.readable?(file)
  return read_env_file(LEGACY_CONFIG) if name == "default" && File.readable?(LEGACY_CONFIG)

  {}
end

def write_profile(name, url, token)
  FileUtils.mkdir_p(CONFIG_DIR)
  file = File.join(CONFIG_DIR, "#{name}.env")
  File.write(file, %(export CMS_URL="#{url}"\nexport USER_AGENT_TOKEN="#{token}"\n))
  File.chmod(0o600, file)

  default_file = File.join(CONFIG_DIR, "default")
  File.write(default_file, "#{name}\n") unless File.exist?(default_file)
end

# --- argument plumbing ------------------------------------------------------

def flag?(name) = ARGV.delete(name) ? true : false

def opt!(name)
  index = ARGV.index(name) or return nil
  ARGV.delete_at(index)
  ARGV.delete_at(index)
end

RAW       = flag?("--raw")
JSON_OUT  = flag?("--json")
AGENT_OUT = flag?("--agent")
HELP_WANTED = flag?("--help") || flag?("-h")

env_profile = [ENV["CMS_PROFILE"]].find { |v| !v.to_s.empty? }
PROFILE = opt!("--profile") || env_profile || default_profile

config = PROFILE ? load_profile(PROFILE) : {}
# The environment wins over a file: CI and one-offs should not need a profile.
# USER_AGENT_TOKEN is the name; CMS_TOKEN is honoured for installs predating it.
BASE  = (ENV["CMS_URL"].presence || config["CMS_URL"]).to_s.chomp("/")
TOKEN = (ENV["USER_AGENT_TOKEN"].presence || ENV["CMS_TOKEN"].presence ||
         config["USER_AGENT_TOKEN"].presence || config["CMS_TOKEN"]).to_s

# --- talking to the API -----------------------------------------------------

class ApiError < StandardError; end

# Everything that can go wrong on the wire. Read timeouts and resets belong here
# alongside DNS failures: from the caller's side they are all "the site did not
# answer", and none of them are worth a backtrace.
NETWORK_ERRORS = [
  SocketError, EOFError, IOError, Errno::ECONNREFUSED, Errno::ECONNRESET,
  Errno::EHOSTUNREACH, Errno::ENETUNREACH, Errno::EPIPE, Errno::ETIMEDOUT,
  Net::OpenTimeout, Net::ReadTimeout, OpenSSL::SSL::SSLError
].freeze

def require_credentials!
  return unless BASE.empty? || TOKEN.empty?

  if PROFILE && !profiles.include?(PROFILE)
    die "no profile named '#{PROFILE}'. Configured: #{profiles.join(", ").presence || "none"}. " \
        "Create it: cms login --url https://<site> --profile #{PROFILE}"
  end
  die "no credentials. Run: cms login --url https://<site>"
end

# The envelope is opt-in per request; asking for it is what turns a bare payload
# into one that says what it is and what to do next.
# $mcp is set while serving a tool call: over MCP there is no human reading
# the output and no stderr channel back to the caller, so the envelope (which
# carries the summary and the next steps in-band) is always what is wanted.
def envelope_wanted? = JSON_OUT || AGENT_OUT || $mcp

def api(method, path, body = nil, content_type: "application/json", binary: false,
        envelope: envelope_wanted?)
  require_credentials!

  # "/api/…" is already absolute; "/pages" and "pages" are shorthand. The test is
  # for the trailing slash — "/api_tokens/me" starts with "/api" and is shorthand.
  unless path.start_with?("/api/")
    path = path.start_with?("/") ? "/api#{path}" : "/api/#{path}"
  end
  uri = URI("#{BASE}#{path}")

  klass = {get: Net::HTTP::Get, post: Net::HTTP::Post,
            patch: Net::HTTP::Patch, delete: Net::HTTP::Delete}[method] or
    raise ApiError, "unsupported method: #{method}"

  request = klass.new(uri)
  request["Authorization"] = "Bearer #{TOKEN}"
  request["Accept"] = "application/json"
  request["X-Agent-Envelope"] = "1" if envelope
  if body
    request["Content-Type"] = content_type
    request.body = body.is_a?(String) ? body : JSON.generate(body)
  end

  response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https",
    open_timeout: 10, read_timeout: 120) do |http|
    http.request(request)
  end

  [response, binary]
rescue *NETWORK_ERRORS => e
  # Guarded here rather than only at the dispatcher, because `work` and `doctor`
  # call this directly and read the response themselves.
  die "cannot reach #{BASE}: #{e.message} (#{e.class})"
end

# Runs a call and prints it the way the caller asked for.
def call(method, path, body = nil, hint: nil, content_type: "application/json", binary: false)
  response, = api(method, path, body, content_type: content_type, binary: binary)
  handle(response, hint: hint, binary: binary)
end

def handle(response, hint: nil, binary: false)
  code = response.code.to_i

  case code
  when 200..299
    if binary
      $stdout.binmode
      $stdout.write(response.body)
      return
    end

    # A 204 has no body. Printing nothing would make a success indistinguishable
    # from a command that died before it spoke, so say so explicitly.
    if response.body.to_s.strip.empty?
      emit(status: "ok", summary: "Done (HTTP #{code}).", data: {}, breadcrumbs: []) if envelope_wanted?
      warn "Done." if !envelope_wanted? && $stderr.tty?
      return
    end

    print_body(response.body)
    warn "Next: #{hint}" if hint && !envelope_wanted? && $stderr.tty?
  when 401
    die "401 unauthorized — the token is wrong, or it was rotated. Run: cms login --url #{BASE}"
  when 403
    warn response.body
    die "403 forbidden — this role doesn't grant that capability. Ask a human to widen the role; don't work around it."
  when 404
    die "404 not found — #{response.uri&.path}"
  else
    warn response.body
    die "HTTP #{code}"
  end
end

def print_body(body)
  return puts(body) if RAW || body.to_s.empty?

  parsed = begin
    JSON.parse(body)
  rescue JSON::ParserError
    return puts(body)
  end

  puts(AGENT_OUT || $mcp ? JSON.generate(parsed) : JSON.pretty_generate(parsed))
end

def emit(payload)
  puts(AGENT_OUT || $mcp ? JSON.generate(payload) : JSON.pretty_generate(payload))
end

# The device-login legs, which are unauthenticated by design — `api` sends a
# bearer token, and not having one is the reason we are here.
def post_raw(url, payload)
  uri = URI(url)
  request = Net::HTTP::Post.new(uri)
  request["Content-Type"] = "application/json"
  request["Accept"] = "application/json"
  request.body = JSON.generate(payload)

  Net::HTTP.start(uri.hostname, uri.port, use_ssl: uri.scheme == "https",
                  open_timeout: 10, read_timeout: 30) { |http| http.request(request) }
rescue SocketError, Errno::ECONNREFUSED => e
  die "cannot reach #{uri.host}: #{e.message}"
end

def post_json(url, payload)
  response = post_raw(url, payload)
  unless response.code.to_i.between?(200, 299)
    warn response.body
    die "HTTP #{response.code} from #{url}"
  end
  JSON.parse(response.body)
end

def read_stdin(message)
  die message if $stdin.tty?
  $stdin.read
end

# `--status draft --page 2` → "?status=draft&page=2"
def query_from(args)
  pairs = []
  until args.empty?
    flag = args.shift
    die "unexpected argument: #{flag}" unless flag.start_with?("--")
    pairs << [flag.sub(/\A--/, ""), args.shift.to_s]
  end
  return "" if pairs.empty?

  "?" + pairs.map { |k, v| "#{URI.encode_www_form_component(k)}=#{URI.encode_www_form_component(v)}" }.join("&")
end

# --- the command catalogue --------------------------------------------------
#
# One table, two readers: the dispatcher runs from it and `cms commands --json`
# prints it. That is the point — a surface described in a comment drifts from
# the surface that runs, and an agent reading the drifted one wastes a call
# finding out. Anything here is callable; anything callable is here.
COMMANDS = []

# The body is installed as a real method rather than kept as a block, so that a
# `return` inside one returns from that command instead of raising LocalJumpError.
def command(name, group:, summary:, usage:, aliases: [], flags: [], notes: nil, nexts: [], &run)
  runner = "run_#{name.gsub(/\W/, "_")}"
  Object.send(:define_method, runner, &run)
  COMMANDS << {name: name, group: group, summary: summary, usage: usage, aliases: aliases,
                flags: flags, notes: notes, next: nexts, runner: runner}
end

def find_command(name)
  COMMANDS.find { |c| c[:name] == name || c[:aliases].include?(name) }
end

def need!(args, count, usage)
  die "usage: #{usage}" if args.size < count
end

# ----- getting connected -----

command("login", group: "Setup",
  summary: "Connect this machine to a site, in a browser, without pasting a token",
  usage: "cms login [--url https://site] [--profile NAME]",
  flags: [{flag: "--url URL", description: "the site to connect to; asked for if omitted"},
           {flag: "--profile NAME", description: "what to call this identity locally (default: the site's host)"}],
  notes: "Prints a short code, waits while you approve it in the browser, then writes " \
         "~/.config/cms/<profile>.env. The token is minted for the person who approves — " \
         "the CLI never sees a password and nobody pastes a secret into a terminal.",
  nexts: ["cms doctor", "cms manifest"]) do |args|
  url = nil
  profile = PROFILE
  until args.empty?
    case (arg = args.shift)
    when "--url" then url = args.shift
    when "--profile" then profile = args.shift
    else die "unexpected argument: #{arg}"
    end
  end

  url ||= ENV["CMS_URL"].presence
  if url.nil?
    die "no --url given, and nothing to guess from. Run: cms login --url https://<site>" unless $stdin.tty?
    $stderr.print "Site URL: "
    url = $stdin.gets.to_s.strip
  end
  url = "https://#{url}" unless url.start_with?("http")
  url = url.chomp("/")
  die "a URL is required" if url.empty?

  start = post_json("#{url}/api/device/code", {hostname: Socket.gethostname})
  profile ||= URI(url).host.split(".").first

  warn ""
  warn "  Open:  #{start["verification_url"]}"
  warn "  Code:  #{start["user_code"]}"
  warn ""
  warn "Waiting for you to approve it…"

  interval = start["interval"].to_i.clamp(1, 30)
  deadline = Time.now + start["expires_in"].to_i.clamp(60, 3600)

  loop do
    die "the code expired before it was approved. Run cms login again." if Time.now > deadline
    sleep interval

    response = post_raw("#{url}/api/device/token", {device_code: start["device_code"]})
    case response.code.to_i
    when 200
      body = JSON.parse(response.body)
      # Save the URL that just worked from this machine, not the one the server
      # believes it lives at — behind a tunnel, a port-forward or a dev proxy those
      # differ, and only one of them is reachable from here.
      write_profile(profile, url, body["token"])
      who = body.dig("user", "name") || body.dig("user", "email")
      warn "Connected as #{who} on #{body["account"] || url}."
      warn "Saved as profile '#{profile}'. Next: cms doctor"
      return
    when 202 then next
    when 403 then die "the request was declined in the browser."
    when 410 then die "the code expired. Run cms login again."
    else die "HTTP #{response.code} while waiting for approval"
    end
  end
end

command("profiles", group: "Setup",
  summary: "List the identities configured on this machine",
  usage: "cms profiles",
  notes: "A profile is one URL plus one token. --profile NAME or CMS_PROFILE picks between them; " \
         "with one configured it is used automatically.") do |_args|
  names = profiles
  if envelope_wanted?
    emit(status: "ok",
         summary: names.empty? ? "No profiles configured." : "#{names.size} profile(s); active: #{PROFILE || "none"}.",
         data: {active: PROFILE, profiles: names.map { |n| {name: n, url: load_profile(n)["CMS_URL"]} }},
         breadcrumbs: [{description: "Connect another site", command: "cms login --url https://<site>"}])
  elsif names.empty?
    warn "No profiles yet. Run: cms login --url https://<site>"
  else
    names.each do |name|
      marker = name == PROFILE ? "*" : " "
      puts "#{marker} #{name.ljust(16)} #{load_profile(name)["CMS_URL"]}"
    end
  end
end

command("config", group: "Setup",
  summary: "Show the URL, token and profile this invocation would use",
  usage: "cms config") do |_args|
  masked = TOKEN.empty? ? "not set" : "#{TOKEN[0, 12]}••••••••"
  if envelope_wanted?
    emit(status: TOKEN.empty? ? "error" : "ok",
         summary: TOKEN.empty? ? "No credentials resolved." : "Configured for #{BASE}.",
         data: {profile: PROFILE, url: BASE.presence, token: masked, config_dir: CONFIG_DIR},
         breadcrumbs: [{description: "Check this machine can work", command: "cms doctor --agent"}])
  else
    puts "profile           #{PROFILE || "none"}"
    puts "CMS_URL           #{BASE.presence || "not set"}"
    puts "USER_AGENT_TOKEN  #{masked}"
    puts "config dir        #{CONFIG_DIR}"
  end
end

command("doctor", group: "Setup",
  summary: "Say whether this machine can actually do work, and what is stopping it",
  usage: "cms doctor [--agent]",
  notes: "Exits non-zero when something is broken, so a provisioning script can gate on it. " \
         "The capability check is the one that catches the quiet failure: a token whose role " \
         "lacks agents:run polls forever and is handed nothing, which looks exactly like an idle queue.",
  nexts: ["cms work", "cms manifest"]) do |_args|
  checks = []
  ok = true

  add = lambda do |name, status, detail, fix = nil|
    ok = false if status == "fail"
    checks << {check: name, status: status, detail: detail, fix: fix}.compact
  end

  if PROFILE
    add.call("profile", "ok", "using profile '#{PROFILE}'")
  elsif !BASE.empty?
    add.call("profile", "ok", "no profile; CMS_URL is set in the environment")
  else
    add.call("profile", "fail", "no profile and no CMS_URL", "cms login --url https://<site>")
  end

  if BASE.empty? || TOKEN.empty?
    add.call("credentials", "fail", "URL or token missing", "cms login --url https://<site>")
    return report_doctor(checks, ok)
  end
  add.call("credentials", "ok", "credentials for #{BASE}")

  identity = begin
    response, = api(:get, "/api_tokens/me", envelope: false)
    case response.code.to_i
    when 200 then JSON.parse(response.body)
    when 401
      add.call("connection", "fail", "the site answered, but rejected the token",
               "cms login --url #{BASE}")
      nil
    else
      add.call("connection", "fail", "HTTP #{response.code} from #{BASE}")
      nil
    end
  rescue StandardError => e
    add.call("connection", "fail", "cannot reach #{BASE}: #{e.class}", "check the URL and the network")
    nil
  end
  return report_doctor(checks, ok) unless identity

  add.call("connection", "ok", "#{BASE} answered")

  who = identity.dig("user", "name") || identity.dig("user", "email") ||
        identity.dig("service", "name") || "unknown"
  kind = identity["user"] ? "person" : "service token"
  add.call("identity", "ok", "#{who} (#{kind})")

  capabilities = Array(identity["capabilities"])
  add.call("capabilities", "ok", "#{capabilities.size} capabilities")

  if capabilities.include?("agents:run")
    add.call("can claim work", "ok", "the role grants agents:run")
  else
    add.call("can claim work", "fail",
             "the role does not grant agents:run — `cms work` will be handed nothing, forever",
             "ask a human to add agents:run to this role")
  end

  writable = capabilities.grep(/:write\z/)
  if writable.any?
    add.call("can write", "ok", writable.sort.join(", "))
  else
    add.call("can write", "warn", "read-only — every write will 403")
  end

  begin
    response, = api(:get, "/agent_runs?status=queued", envelope: false)
    if response.code.to_i == 200
      body = JSON.parse(response.body)
      runs = body.is_a?(Hash) ? (body["agent_runs"] || body["data"] || []) : body
      count = runs.is_a?(Array) ? runs.size : 0
      add.call("work", "ok", count.zero? ? "nothing queued" : "#{count} run(s) queued")
    else
      add.call("work", "warn", "could not read the queue (HTTP #{response.code})")
    end
  rescue StandardError => e
    add.call("work", "warn", "could not read the queue: #{e.class}")
  end

  harness = %w[claude codex opencode].select { |bin| system("command -v #{bin} >/dev/null 2>&1") }
  if harness.any?
    add.call("harness", "ok", "found on PATH: #{harness.join(", ")}")
  else
    add.call("harness", "warn", "no claude/codex/opencode on PATH — fine for a person, not for a worker loop")
  end

  report_doctor(checks, ok)
end

def report_doctor(checks, ok)
  if envelope_wanted?
    failed = checks.select { |c| c[:status] == "fail" }
    emit(status: ok ? "ok" : "error",
         summary: ok ? "Ready to work." : "Not ready: #{failed.map { |c| c[:check] }.join(", ")}.",
         data: {healthy: ok, checks: checks},
         breadcrumbs: failed.filter_map { |c| c[:fix] && {description: "Fix #{c[:check]}", command: c[:fix]} })
  else
    checks.each do |check|
      mark = {"ok" => "✓", "warn" => "!", "fail" => "✗"}[check[:status]]
      puts "#{mark} #{check[:check].ljust(16)} #{check[:detail]}"
      puts "  #{" " * 16} → #{check[:fix]}" if check[:fix]
    end
    puts(ok ? "\nReady to work." : "\nNot ready.")
  end
  exit(ok ? 0 : 1)
end

command("commands", group: "Setup",
  summary: "Print every command, with its flags and the traps, in one call",
  usage: "cms commands [--json]",
  notes: "Written for an agent: read this once instead of discovering the surface " \
         "one usage error at a time.") do |_args|
  if JSON_OUT || AGENT_OUT
    emit(status: "ok",
         summary: "#{COMMANDS.size} commands.",
         data: {version: VERSION,
                 global_flags: GLOBAL_FLAGS,
                 commands: COMMANDS.map { |c| c.reject { |k, _| k == :run } }},
         breadcrumbs: [{description: "Check this machine can work", command: "cms doctor --agent"}])
  else
    COMMANDS.group_by { |c| c[:group] }.each do |group, entries|
      puts "\n#{group}"
      entries.each { |c| puts "  #{c[:name].ljust(16)} #{c[:summary]}" }
    end
    puts "\ncms <command> --help for one, cms commands --json for all of it at once."
  end
end

command("version", group: "Setup", aliases: ["--version"],
  summary: "Print the CLI version",
  usage: "cms version") do |_args|
  envelope_wanted? ? emit(status: "ok", summary: "cms #{VERSION}", data: {version: VERSION}) : puts("cms #{VERSION}")
end

