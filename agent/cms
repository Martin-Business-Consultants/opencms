# ----- the MCP server -----

command("mcp", group: "Setup",
  summary: "Speak MCP on stdio, so an editor can call the CMS directly",
  usage: "cms mcp",
  notes: "Wire it up once: `claude mcp add cms -- #{$PROGRAM_NAME} mcp`. Every curated " \
         "command becomes a tool, with the same catalogue behind it, so the two never drift.") do |_args|
  require_credentials!
  run_mcp_server
end

# Deliberately small: MCP over stdio is newline-delimited JSON-RPC, and the whole
# server is "expose the catalogue as tools". Anything cleverer would be a second
# description of the same surface, which is the thing this file exists to avoid.
def run_mcp_server
  $stdout.sync = true

  tools = COMMANDS.reject { |c| %w[mcp login help commands version].include?(c[:name]) }.map do |c|
    {name: c[:name].tr("-", "_"),
      description: [c[:summary], c[:notes]].compact.join(" — "),
      inputSchema: {type: "object",
                     properties: {args: {type: "array", items: {type: "string"},
                                           description: "Arguments, as you would type them: #{c[:usage]}"}}}}
  end

  while (line = $stdin.gets)
    request = begin
      JSON.parse(line)
    rescue JSON::ParserError
      next
    end
    id = request["id"]

    result = case request["method"]
    when "initialize"
      {protocolVersion: "2024-11-05", capabilities: {tools: {}},
        serverInfo: {name: "cms", version: VERSION}}
    when "tools/list" then {tools: tools}
    when "tools/call"
      name = request.dig("params", "name").to_s.tr("_", "-")
      args = Array(request.dig("params", "arguments", "args")).map(&:to_s)
      {content: [{type: "text", text: capture_command(name, args)}]}
    when "notifications/initialized" then nil
    else {error: "unknown method"}
    end

    next if id.nil?

    puts JSON.generate({jsonrpc: "2.0", id: id, result: result})
  end
end

# Runs a command with stdout captured, so MCP can return what it printed as the
# tool result rather than leaking it into the JSON-RPC stream.
def capture_command(name, args)
  entry = find_command(name) or return "unknown command: #{name}"

  out_was, err_was = $stdout, $stderr
  out, err = StringIO.new, StringIO.new
  $stdout, $stderr = out, err
  $mcp = true
  begin
    send(entry[:runner], args)
    out.string.presence || err.string
  rescue SystemExit
    # `die` writes the reason to stderr and exits. That reason is the answer.
    [out.string, err.string].reject(&:empty?).join("\n").presence || "the command exited"
  rescue StandardError => e
    "#{e.class}: #{e.message}"
  ensure
    $stdout, $stderr = out_was, err_was
    $mcp = nil
  end
end

# --- help -------------------------------------------------------------------

GLOBAL_FLAGS = [
  {flag: "--agent", description: "compact JSON, and ask the server for the {status, summary, data, breadcrumbs} envelope"},
  {flag: "--json", description: "the envelope, pretty-printed — the same thing for human eyes"},
  {flag: "--raw", description: "the response body exactly as it came, unformatted"},
  {flag: "--profile NAME", description: "which configured identity to use"},
  {flag: "--help", description: "usage for one command; add --agent for it as JSON"}
].freeze

def command_help(entry)
  if envelope_wanted?
    emit(status: "ok", summary: entry[:summary],
         data: entry.reject { |k, _| k == :runner },
         breadcrumbs: entry[:next].map { |c| {description: "Then", command: c} })
  else
    puts entry[:usage]
    puts
    puts entry[:summary]
    if entry[:flags].any?
      puts
      entry[:flags].each { |f| puts "  #{f[:flag].ljust(20)} #{f[:description]}" }
    end
    if entry[:notes]
      puts
      puts entry[:notes]
    end
    if entry[:next].any?
      puts
      puts "Next: #{entry[:next].join(" · ")}"
    end
  end
end

def usage
  puts <<~TEXT
    cms #{VERSION} — the CMS from a terminal, for people and for agents.

    Usage: cms <command> [args] [flags]

    Start here
      cms login --url https://<site>   connect this machine, in a browser
      cms doctor                       can this machine actually do work?
      cms manifest                     the shape of this CMS, before you write to it
      cms commands --json              the whole surface at once

  TEXT

  COMMANDS.group_by { |c| c[:group] }.each do |group, entries|
    puts group
    entries.each { |c| puts "  #{c[:name].ljust(16)} #{c[:summary]}" }
    puts
  end

  puts "Flags"
  GLOBAL_FLAGS.each { |f| puts "  #{f[:flag].ljust(20)} #{f[:description]}" }
  puts
  puts "cms <command> --help for one command. Configuration lives in #{CONFIG_DIR}."
end

# --- dispatch ---------------------------------------------------------------

name = ARGV.shift

if name.nil? || %w[help -h].include?(name)
  # `cms --help` with no command is the usage screen; `cms <command> --help` is
  # that command. HELP_WANTED has already eaten the flag by this point.
  if HELP_WANTED && name.nil?
    usage
  elsif name == "help" && (target = find_command(ARGV.first.to_s))
    command_help(target)
  else
    usage
  end
  exit 0
end

entry = find_command(name) or
  die "unknown command: #{name}. Try `cms commands` for the whole surface."

if HELP_WANTED
  command_help(entry)
  exit 0
end

begin
  send(entry[:runner], ARGV)
rescue Interrupt
  exit 130
rescue Errno::EPIPE
  exit 0
rescue *NETWORK_ERRORS => e
  die "cannot reach #{BASE.presence || "the site"}: #{e.message} (#{e.class})"
end
