# ----- service tokens -----
#
# A service token belongs to the site, not to a person, and carries the role
# named on it. The list never contains a secret; create, reveal and rotate
# each return one, once, and each is audited.

command("service-tokens", group: "Service tokens",
  summary: "Every token, and the roles you can issue against",
  usage: "cms service-tokens",
  notes: "The list never contains a secret. create, reveal and rotate each return one, once. " \
         "Print a secret for the person who asked; never write one into a file, a repo, or a commit.",
  nexts: ["cms service-token reveal <id>"]) do |_args|
  call(:get, "/service_tokens", hint: "cms service-token reveal <id> — show that token's secret again")
end

command("service-token", group: "Service tokens",
  summary: "Issue, reveal, rotate, revoke, or show one service token",
  usage: "cms service-token create --name NAME --role ROLE [--description TEXT] | " \
         "cms service-token reveal|rotate|revoke <id> | cms service-token <id>",
  flags: [{flag: "--name NAME", description: "what the token is for, e.g. PRODUCTION"},
          {flag: "--role ROLE", description: "role name or id, e.g. 'Production site'"},
          {flag: "--description TEXT", description: "optional note"}],
  notes: "Only create, reveal and rotate return a secret, and only once each. " \
         "Issuing or revealing needs settings:write. Alias: create also accepts 'new'.") do |args|
  need!(args, 1, "cms service-token create --name NAME --role ROLE [--description TEXT] | " \
                 "cms service-token reveal|rotate|revoke <id> | cms service-token <id>")
  action = args.shift
  case action
  when "create", "new"
    name = role = desc = nil
    until args.empty?
      case (arg = args.shift)
      when "--name" then name = args.shift
      when "--role" then role = args.shift
      when "--description" then desc = args.shift
      else die "unexpected argument: #{arg}"
      end
    end
    die "--name is required — say what the token is for, e.g. --name PRODUCTION" if name.to_s.empty?
    die "--role is required — e.g. --role 'Production site'. 'cms service-tokens' lists the roles." if role.to_s.empty?
    body = {"name" => name, "role" => role}
    body["description"] = desc unless desc.to_s.empty?
    call(:post, "/service_tokens", body)
  when "reveal", "rotate", "revoke"
    need!(args, 1, "cms service-token #{action} <id>")
    call(:post, "/service_tokens/#{args[0]}/#{action}", {})
  else
    call(:get, "/service_tokens/#{action}")
  end
end

