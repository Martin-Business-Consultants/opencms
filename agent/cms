  usage: "cms schedule <key> [--on|--off] [--cron \"0 3 * * *\"] [--set name=value ...]",
  flags: [{flag: "--on / --off", description: "run it on its schedule, or not"},
           {flag: "--cron EXPR", description: "a standard cron expression"},
           {flag: "--set name=value", description: "one of the recipe's settings (cms schedules lists them)"}],
  nexts: ["cms run-task <key>"]) do |args|
  need!(args, 1, "cms schedule <key> [--on|--off] [--cron EXPR] [--set name=value]")
  key = args.shift
  task = {}
  settings = {}
  until args.empty?
    case (flag = args.shift)
    when "--on" then task[:enabled] = true
    when "--off" then task[:enabled] = false
    when "--cron" then task[:cron] = args.shift
    when "--set"
      name, value = args.shift.to_s.split("=", 2)
      settings[name] = value.to_s.match?(/\A-?\d+\z/) ? value.to_i : value
    else die "unknown flag: #{flag}"
    end
  end
  task[:params] = settings if settings.any?
  die "nothing to change: pass --on, --off, --cron or --set" if task.empty?
  call(:patch, "/tools/recurring_tasks/#{key}", {task: task})
end

