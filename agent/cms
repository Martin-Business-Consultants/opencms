command("pages", group: "Content",
  summary: "Every page, filterable",
  usage: "cms pages [--status draft|published] [--page N]",
  flags: [{flag: "--status S", description: "draft, published, scheduled"},
           {flag: "--page N", description: "page through longer lists"}],
  nexts: ["cms page <path>"]) do |args|
  call(:get, "/pages#{query_from(args)}", hint: "cms page <path> — one page with its blocks expanded")
end

command("page", group: "Content",
  summary: "One page, with its blocks and assets resolved",
  usage: "cms page <path>",
  notes: "The path is the site path without a leading slash: `cms page about/team`.") do |args|
  need!(args, 1, "cms page <path>")
  call(:get, "/pages/#{args[0]}?resolve=assets")
end

command("collections", group: "Content",
  summary: "Every collection and its schema",
