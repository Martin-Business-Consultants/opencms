# A checklist (GET /api/go_live, /api/site_health) as a person reads it: its
# checks by group, each passing (✓), to do (✗) or yours to judge (?), with the
# command that fixes one still to do.
def print_checklist(path, ready_words)
  if envelope_wanted?
    call(:get, path)
    return
  end

  response, = api(:get, path, envelope: false)
  return handle(response) unless response.code.to_i == 200

  body = JSON.parse(response.body)
  body["checks"].group_by { it["group"] }.each do |group, checks|
    puts "\n#{group}"
    checks.each do |check|
      mark = check["ok"].nil? ? "?" : (check["ok"] ? "✓" : "✗")
      puts "  #{mark} #{check["title"]}"
      puts "      #{check["detail"]}" if check["ok"] == false
      puts "      #{check["cli"]}" if check["ok"] == false && check["cli"]
    end
  end
  summary = body["summary"]
  puts "\n#{summary["passing"]} of #{summary["total"]} pass#{summary["ready"] ? " — #{ready_words}." : "."}"
end

