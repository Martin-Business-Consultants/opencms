command("whoami", group: "Orientation",
  summary: "Who this credential is, and what its role lets it do",
  usage: "cms whoami",
  nexts: ["cms manifest"]) do |_args|
  call(:get, "/api_tokens/me", hint: "cms manifest — the shape of this CMS")
end

command("manifest", group: "Orientation",
  summary: "The shape of this CMS: collections, schemas, block types, brand",
  usage: "cms manifest",
  notes: "Read this before writing anything. A field name guessed from the front end " \
         "is the usual cause of a 422.",
  nexts: ["cms pages", "cms entries <collection>"]) do |_args|
  call(:get, "/manifest", hint: "cms pages / cms entries <collection> — the content itself")
end

command("brand", group: "Orientation",
  summary: "The brand brief on its own — voice, audience, what not to say",
  usage: "cms brand",
  notes: "The `brand` key of the manifest, pulled out because it is what you want in " \
         "front of you before writing a word of copy.") do |_args|
  response, = api(:get, "/manifest", envelope: false)
  unless response.code.to_i == 200
    handle(response)
    return
  end
  body = JSON.parse(response.body)
  brand = body["brand"] || body.dig("data", "brand")
  if envelope_wanted?
    emit(status: "ok", summary: brand ? "The brand brief." : "This CMS has no brand brief.",
         data: {brand: brand}, breadcrumbs: [{description: "The full shape", command: "cms manifest"}])
  else
    puts JSON.pretty_generate(brand)
  end
end

