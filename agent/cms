command("work", group: "Agent work", aliases: ["claim"],
  summary: "Claim one queued run and get its instructions",
  usage: "cms work [--worker NAME] [--lease SECONDS]",
  flags: [{flag: "--worker NAME", description: "who is claiming (default: this hostname)"},
           {flag: "--lease SECONDS", description: "how long before it returns to the queue (default 600)"}],
  notes: "Exits 3 when nothing is queued — distinct from 1, so a polling loop can tell " \
         "\"idle\" from \"broken\". Needs agents:run; a role without it is handed nothing " \
         "and looks exactly like an empty queue. `cms doctor` checks for that.",
  nexts: ["cms run-start <id>"]) do |args|
  worker = nil
  lease = nil
  until args.empty?
    case (arg = args.shift)
    when "--worker" then worker = args.shift
    when "--lease"  then lease = args.shift
    else die "unexpected argument: #{arg}"
    end
  end

  # The generic handler treats every non-2xx as fatal and cannot say anything
  # useful about a 204, so claiming does its own thing with the response.
  response, = api(:post, "/agent_runs/claim",
                  {worker: worker || Socket.gethostname, lease_seconds: (lease || 600).to_i})

  case response.code.to_i
  when 204
    if envelope_wanted?
      emit(status: "empty", summary: "Nothing queued.", data: {},
           breadcrumbs: [{description: "Poll again shortly", command: "cms work --agent"}])
    else
      warn "Nothing queued."
    end
    exit 3
  when 200..299
    print_body(response.body)
    warn "Next: cms run-start <id>, then run-step / run-ping as you go, then run-done" if !envelope_wanted? && $stderr.tty?
  when 403
    die "403 — this token's role is missing 'agents:run'. Ask a human to widen it; run `cms doctor` to confirm."
  else
    handle(response)
  end
end

