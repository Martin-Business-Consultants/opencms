<%# The CMS's own layout for both notification (admin) and confirmation
    (user) emails, used until the Astro site has built a template from the
    email's current blocks: the logo, the blocks, and a kind-specific footer. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f7f7f5;padding:24px 0;">
  <tr>
    <td align="center">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #e7e5e4;border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#1c1917;">

        <% if @logo_url.present? %>
        <tr>
          <td align="center" style="padding:24px 24px 8px;">
            <img src="<%= @logo_url %>" alt="<%= @form.title %>" style="max-height:48px;max-width:200px;display:block;margin:0 auto;">
          </td>
        </tr>
        <% end %>

        <tr><td style="height:8px;line-height:0;font-size:0;">&nbsp;</td></tr>
        <%= render "form_submission_mailer/blocks", blocks: @blocks, form: @form, submission: @submission %>
        <tr><td style="height:16px;line-height:0;font-size:0;">&nbsp;</td></tr>

        <tr>
          <td style="padding:16px 32px 24px;border-top:1px solid #e7e5e4;font-size:12px;color:#a8a29e;">
            <% if @form_email.notification? %>
              Submission #<%= @submission.id %> from <%= @submission.ip || "—" %>
              · <%= @submission.created_at.to_fs(:long) %>
            <% else %>
              Sent in response to your submission to "<%= @form.title %>" on
              <%= @submission.created_at.to_fs(:long) %>.
            <% end %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
