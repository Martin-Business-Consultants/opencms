<% @page_title = "Edit Invoice" %>
<%= parent_page @invoice.number, invoice_path(@invoice) %>

<% content_for :page_actions do %>
  <%= link_to "Add New", new_invoice_path, class: "btn txt-small" %>
  <%= link_to "View invoice", invoice_path(@invoice), class: "btn txt-small" %>
<% end %>
<%= render "layouts/shared/page_header", title: @page_title, description: @invoice.number.to_s + " · " + @invoice.customer_name.to_s %>
<%= render "invoices/form", invoice: @invoice %>
