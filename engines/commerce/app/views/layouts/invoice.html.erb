<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title><%= content_for?(:title) ? yield(:title) : "Invoice" %></title>
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #f5f5f4; color: #1c1917; font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
      .sheet { max-width: 760px; margin: 32px auto; background: #fff; border: 1px solid #e7e5e4; border-radius: 12px; padding: 40px; }
      header { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; }
      h1 { margin: 0; font-size: 26px; }
      .muted { color: #78716c; }
      .eyebrow { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: #78716c; margin: 0 0 4px; }
      .status { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
      .status-paid { background: #dcfce7; color: #166534; } .status-sent, .status-draft { background: #fef3c7; color: #92400e; } .status-void { background: #f5f5f4; color: #78716c; text-decoration: line-through; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 28px; }
      table { width: 100%; border-collapse: collapse; margin-top: 28px; }
      th, td { padding: 10px 8px; border-bottom: 1px solid #e7e5e4; text-align: left; vertical-align: top; }
      th { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: #78716c; }
      td.num, th.num { text-align: right; white-space: nowrap; }
      tfoot td { border: 0; }
      tfoot tr.total td { font-weight: 700; font-size: 18px; border-top: 2px solid #1c1917; }
      .pay { display: inline-block; margin-top: 24px; background: #1c1917; color: #fff; text-decoration: none; font-weight: 600; padding: 14px 28px; border-radius: 10px; }
      .notes { margin-top: 28px; font-size: 14px; color: #44403c; white-space: pre-line; }
      footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid #e7e5e4; font-size: 12px; color: #a8a29e; }
      @media print { body { background: #fff; } .sheet { border: 0; margin: 0; max-width: none; } .pay, .no-print { display: none; } }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
